{
  "schemaVersion": 1,
  "id": "eblochat",
  "version": "${version}",
  "name": "Blockly",
  "description": "Twitch chat inside Minecraft with Chatterino-style features: multi-channel tabs, badges, history, mentions, moderation events, user cards.",
  "authors": [],
  "license": "MIT",
  "icon": "assets/eblochat/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["id.eblo.chat.EbloChatClient"],
    "modmenu": ["id.eblo.chat.ModMenuIntegration"]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github": "https://github.com/mrkilot/EbloChat"
      }
    }
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "fabric-api": ">=0.155.0",
    "minecraft": "~26.1",
    "java": ">=25"
  }
}
